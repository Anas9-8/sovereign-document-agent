# Ollama LLM settings
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB vector store
CHROMA_PATH=./data/chroma

# Document ingestion
DOCS_PATH=./data/docs
REGISTRY_PATH=./data/registry.json
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_FILE_SIZE_MB=50

# Retrieval
TOP_K_RESULTS=3

# API
API_PORT=8000

# Logging
LOG_LEVEL=INFO
